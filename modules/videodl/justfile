# ─── videodl — yt-dlp video & subtitle manager ──────────────
#
# Prerequisites:
#   yt-dlp (https://github.com/yt-dlp/yt-dlp) — CLI, user-managed
#   ffmpeg — brew install ffmpeg
#   Node.js 18+ — for gen-index.ts
#   Rust toolchain — for static-server (HTTP server)
#
# Config: config/.env + config/.env.dev.local
#   VIDEO_DL_ROOT   — download root directory
#   SUBTITLE_LANGS  — subtitle language priority (default: en,zh-Hans)
#   VIDEO_DL_PROXY — proxy URL (e.g. http://127.0.0.1:7890)
#
# Usage:  just videodl::<task>
#   e.g.  just videodl::dl "https://youtube.com/watch?v=..."
#         just videodl::gen-index
#         just videodl::serve
# ────────────────────────────────────────────────────────────

MODULE_DIR := justfile_directory() / "modules" / "videodl"
SCRIPT_DIR := MODULE_DIR / "scripts"
DL_SCRIPT := SCRIPT_DIR / "dl.sh"
GEN_SCRIPT := SCRIPT_DIR / "gen-index.ts"
COOKIES_SCRIPT := SCRIPT_DIR / "cookies.sh"
NOTIFY_WRAPPER := justfile_directory() / "modules" / "notify" / "scripts" / "run-and-notify.sh"

# ── env ────────────────────────────────────────────────────

env:
    @echo "═══ videodl module environment ═══"
    @echo "VIDEO_DL_ROOT   = ${VIDEO_DL_ROOT:-(not set)}"
    @if [ -n "${VIDEO_DL_ROOT:-}" ] && [ -d "${VIDEO_DL_ROOT}" ]; then \
        echo "  channel/       = `find "${VIDEO_DL_ROOT}/channel" -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' '` channel dir(s)" ; \
        echo "  playlist/      = `find "${VIDEO_DL_ROOT}/playlist" -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' '` playlist dir(s)" ; \
        if [ -f "${VIDEO_DL_ROOT}/archive.txt" ]; then \
            echo "  archive.txt    = exists (`wc -l < "${VIDEO_DL_ROOT}/archive.txt" | tr -d ' '` entries)" ; \
        else \
            echo "  archive.txt    = not found" ; \
        fi ; \
        test -f "${VIDEO_DL_ROOT}/index.html" && echo "  index.html     = yes" || echo "  index.html     = not generated" ; \
        test -d "${VIDEO_DL_ROOT}/.videodl-assets" && echo "  .videodl-assets/ = yes" || echo "  .videodl-assets/ = not generated" ; \
    fi
    @echo "SUBTITLE_LANGS  = ${SUBTITLE_LANGS:-en,zh-Hans}"
    @echo "VIDEO_DL_PROXY  = ${VIDEO_DL_PROXY:-(not set)}"
    @echo "COOKIES_FROM    = ${COOKIES_FROM:-(not set)}"
    @echo "COOKIES_FILE    = ${COOKIES_FILE:-(not set)}"
    @if [ -f "{{ MODULE_DIR }}/.cookies" ]; then \
        echo "  .cookies       = exists (`wc -l < "{{ MODULE_DIR }}/.cookies" | tr -d ' '` lines, generated by 'just videodl::cookies')" ; \
    else \
        echo "  .cookies       = not found (run: just videodl::cookies)" ; \
    fi
    @echo ""
    @echo "═══ paths ═══"
    @echo "DL script       = {{ DL_SCRIPT }}"
    @test -f {{ DL_SCRIPT }} && echo "  → exists ✓" || echo "  → missing ✗"
    @echo "GEN script      = {{ GEN_SCRIPT }}"
    @test -f {{ GEN_SCRIPT }} && echo "  → exists ✓" || echo "  → missing ✗"
    @echo ""
    @echo "═══ tools ═══"
    @echo "yt-dlp          = `yt-dlp --version 2>/dev/null || echo not found` (`command -v yt-dlp 2>/dev/null || echo 'not in PATH'`)"
    @echo "ffmpeg          = `ffmpeg -version 2>/dev/null | head -1 || echo 'not found'`"
    @echo "node            = `node --version 2>/dev/null || echo 'not found'`"
    @echo "pnpm            = `pnpm --version 2>/dev/null || echo 'not found'`"
    @cargo build --bin static-server --quiet 2>/dev/null && echo "static-server   = built ✓" || echo "static-server   = not built (run: just videodl::build)"
    @echo ""

# ── init ───────────────────────────────────────────────────

# Initialize: create root directories
init:
    @echo "🔧 Initializing videodl module ..." && \
    mkdir -p "${VIDEO_DL_ROOT}/channel" "${VIDEO_DL_ROOT}/playlist" "${VIDEO_DL_ROOT}/single" "${VIDEO_DL_ROOT}/temp" && \
    echo "  ✓ Created directory structure under ${VIDEO_DL_ROOT}" && \
    echo "✅ Init complete"

# ── download ───────────────────────────────────────────────

# Download video + subtitles (default: ≤1080p, with notification)
dl url:
    @bash '{{ NOTIFY_WRAPPER }}' "videodl::dl" {{ DL_SCRIPT }} "{{ url }}"

# Download best quality (unlimited resolution, with notification)
dl-best url:
    @bash '{{ NOTIFY_WRAPPER }}' "videodl::dl-best" {{ DL_SCRIPT }} --best "{{ url }}"

# Download audio only (with notification)
dl-audio url:
    @bash '{{ NOTIFY_WRAPPER }}' "videodl::dl-audio" {{ DL_SCRIPT }} --audio "{{ url }}"

# Download subtitles only (with notification)
dl-sub-only url:
    @bash '{{ NOTIFY_WRAPPER }}' "videodl::dl-sub-only" {{ DL_SCRIPT }} --sub-only "{{ url }}"

# Download with custom format (with notification)
dl-with-format format url:
    @bash '{{ NOTIFY_WRAPPER }}' "videodl::dl-with-format" {{ DL_SCRIPT }} --format "{{ format }}" "{{ url }}"

# Download with browser cookies (with notification)
dl-cookie url:
    @bash '{{ NOTIFY_WRAPPER }}' "videodl::dl-cookie" env COOKIES_FROM=chrome {{ DL_SCRIPT }} "{{ url }}"

# ── info ───────────────────────────────────────────────────

# List available formats and subtitles
list url:
    @{{ DL_SCRIPT }} --list "{{ url }}"

# Show video metadata (JSON)
info url:
    @{{ DL_SCRIPT }} --info "{{ url }}"

# View download archive (already downloaded IDs)
archive:
    @if [ -f "${VIDEO_DL_ROOT}/archive.txt" ]; then \
        echo "═══ Download archive (${VIDEO_DL_ROOT}/archive.txt) ═══" && \
        wc -l "${VIDEO_DL_ROOT}/archive.txt" | awk '{print "  Total: " $$1 " entries"}'; \
    else \
        echo "No archive file yet. Download something first!"; \
    fi

# Update yt-dlp to latest version
update:
    yt-dlp -U

# ── cookies ─────────────────────────────────────────────────

# Export cookies from browser to local .cookies file (never committed)
# Usage: just videodl::cookies [browser]
# browser: chrome (default), firefox, safari, brave, etc.
cookies browser="chrome":
    @{{ COOKIES_SCRIPT }} "{{ browser }}" "{{ MODULE_DIR }}/.cookies"

# ── browse ─────────────────────────────────────────────────

# Scan directory and generate index.html + player.html
gen-index:
    @echo "📂 Generating video index ..." && \
    export VIDEO_DL_ROOT && \
    cd {{ MODULE_DIR }} && npx tsx {{ GEN_SCRIPT }}

# Build all module dependencies (static-server, etc.)
build:
    @echo "🔨 Building dependencies ..." && \
    cargo build --bin static-server --quiet && \
    echo "✓ static-server ready"

# Build static-server binary only
_build-static-server:
    @cargo build --bin static-server --quiet

# Start HTTP server for Chrome playback
serve: _build-static-server
    @echo "🌐 Serving ${VIDEO_DL_ROOT} on http://localhost:8080" && \
    cargo run --bin static-server -- "${VIDEO_DL_ROOT}"

# Open root directory in Finder
browse:
    @open "${VIDEO_DL_ROOT}"

# Search and play a video matching keyword (opens in QuickTime)
play keyword:
    @echo "🔍 Searching for: {{ keyword }} ..." && \
    FILE=$$(find "${VIDEO_DL_ROOT}" -type f \( -name "*.mp4" -o -name "*.mkv" \) \
        | head -50 | fzf --query="{{ keyword }}" --select-1 --prompt="Select video: " 2>/dev/null) && \
    if [ -n "$$FILE" ]; then \
        echo "  ▶ Playing: $$(basename "$$FILE")" && \
        open "$$FILE"; \
    else \
        echo "  No match found"; \
    fi
