# ─── secrets & local config ──────────────────────────────────
# Ignore all .env files anywhere, except .env.example
.env*
!.env.example
!config/.env.example

# ─── AI agent config ────────────────────────────────────────
.pi/
.claude/
.cursor/

# ─── drafts / planning notes (any dir) ──────────────────────
*-draft.md

# ─── temp files (notification wrapper) ───────────────────
.tmp/

# ─── OS ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── IDE ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Rust ─────────────────────────────────────────────────────
target/
Cargo.lock

# ─── logs ───────────────────────────────────────────────────
logs/
*.log

# ─── notify ────────────────────────────────────
modules/notify/notify.log

# ─── Node.js / TypeScript ───────────────────────
node_modules/
dist/
*.tsbuildinfo
coverage/
.eslintcache

# ─── videodl ─────────────────────────────────────
modules/videodl/pnpm-lock.yaml

# Generated cookies (local only, never commit)
modules/videodl/.cookies

# ─── Python / uv ─────────────────────────────────────
__pycache__/
*.pyc
uv.lock

# Python virtual environments (anywhere in the project)
.venv/

# Beancount ledger files (sensitive financial data, must stay outside repo)
*.beancount
