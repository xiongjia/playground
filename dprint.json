{
  "markdown": {
    "lineWidth": 100,
    "textWrap": "always"
  },
  "json": {
    "indentWidth": 2
  },
  "includes": [
    "**/*.md",
    "**/*.json"
  ],
  "excludes": [
    "**/.*",
    "**/*-draft.md"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.22.1.wasm",
    "https://plugins.dprint.dev/json-0.19.4.wasm"
  ]
}
