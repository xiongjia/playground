# ─── config/.env.example ─────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env — it contains secrets.
#
# Loading order: config/.env then config/.env.dev.local (loaded together via dotenv-command)
# Create config/.env.dev.local for machine-local overrides (also gitignored).
# ────────────────────────────────────────────────────────────

# restic repository
RESTIC_PASSWORD=change-me-to-a-strong-password
RESTIC_REPOSITORY=sftp:user@host:/path/to/restic-repo

# Local repository example (uncomment and adjust):
# RESTIC_REPOSITORY=/Volumes/BackupDrive/restic-repo

# S3 / B2 example (uncomment and adjust):
# RESTIC_REPOSITORY=s3:bucket-name:/path
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Hostname tag — set explicitly so snapshots are portable across machines
HOSTNAME=my-machine

# Snapshot tag — identifies backups from this project when filtering or forgetting
# Choose a name you'll recognise, e.g. workstation, home-server, my-backup
BACKUP_TAG=my-backup

# Parent directory — cd here before backup so restic stores relative paths
# Example: if BACKUP_PARENT=/home/user, BACKUP_SOURCE_DIR="data projects" stores data/* and projects/*
# Leave unset (empty) to use absolute paths in the snapshot
# BACKUP_PARENT=/home/user

# Directory(ies) to back up — space-separated
# When BACKUP_PARENT is set:  relative paths under BACKUP_PARENT
# When BACKUP_PARENT is unset: absolute paths
# Single:   BACKUP_SOURCE_DIR=/path/to/data
# Multiple: BACKUP_SOURCE_DIR="/path/to/a /path/to/b /path/to/c"
BACKUP_SOURCE_DIR=/path/to/your-important-data
