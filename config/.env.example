# ─── config/.env.example ─────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env — it contains secrets.
#
# Loading order: config/.env then config/.env.dev.local
# Create config/.env.dev.local for machine-local overrides (also gitignored).
#
# Detailed docs for each variable → modules/<name>/README.md
# ────────────────────────────────────────────────────────────

# ── Global ─────────────────────────────────────────────────
HOSTNAME=my-machine              # Hostname tag for restic snapshots
NOTIFY_SILENT=false              # Set true to disable all notifications

# ── backup ────────────────────────────────────────────────
# See modules/backup/README.md for details; for S3/B2 backends
# add AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here.
RESTIC_PASSWORD=change-me-to-a-strong-password
RESTIC_REPOSITORY=sftp:user@host:/path/to/restic-repo
BACKUP_TAG=my-backup
BACKUP_SOURCE_DIR=/path/to/your-important-data
# BACKUP_PARENT=/home/user

# ── videodl ───────────────────────────────────────────────
# VIDEO_DL_ROOT=/Volumes/Media/yt-dlp
SUBTITLE_LANGS=en,zh-Hans,ja,ko
# VIDEO_DL_PROXY=http://127.0.0.1:7890
# COOKIES_FROM=chrome
# COOKIES_FILE=/path/to/cookies.txt

# ── notify ────────────────────────────────────────────────
# NOTIFY_TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# NOTIFY_TELEGRAM_CHAT_ID=123456789
# NOTIFY_TELEGRAM_PROXY=http://127.0.0.1:7890
NOTIFY_DEFAULT_CHANNEL=telegram
# NOTIFY_LOG_FILE=
NOTIFY_TAIL_LINES=30

# ── finance ───────────────────────────────────────────────
# FINANCE_BEANCOUNT_FILE=/path/to/your/main.beancount
FINANCE_FAVA_PORT=5500
# FINANCE_PROXY=http://127.0.0.1:7890

# ── robot ─────────────────────────────────────────────────
# ROBOT_ANTI_SLEEP_INTERVAL=30-90
# ROBOT_ANTI_SLEEP_MAX_MOVE=5
# ROBOT_ANTI_SLEEP_USER_THRESHOLD=20

# ── md-export ─────────────────────────────────────────────
# MD_EXPORT_ROOT=/path/to/exports
# MD_EXPORT_FORMATS=pdf
# MD_EXPORT_PDF_FONT=Songti SC
# MD_EXPORT_PDF_ENGINE=weasyprint
# MD_EXPORT_EXCLUDE=CHANGELOG.md my-note.md
